# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Sanity Studio build output (npm run sanity:deploy)
/dist

# Sanity's local runtime shim — auto-generated, and its own header says edits are
# discarded. Not source.
/.sanity

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which must ship so a fresh checkout knows the shape.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload's local-disk upload fallback — runtime data, not source. Real uploads
# belong in Supabase Storage (S3_* vars); files written here vanish on redeploy.
/media

# tool-generated indexes — these hold live database files, and Tailwind's
# automatic content detection must not walk into them (see app/globals.css)
/.codegraph
/.gitnexus
/.playwright-mcp
