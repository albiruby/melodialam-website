# --- Sanity ---------------------------------------------------------------
# The project id and both dataset names are NOT here. They are literals in
# `lib/sanity-project.ts`, because `sanity.config.ts` is built twice — by Next
# for the embedded Studio and by Sanity's own bundler for the hosted one — and
# the two expose environment variables differently. A literal is the only form
# both bundlers agree on. See that module for the full explanation.
#
# Reading articles therefore needs no configuration at all: the `production`
# dataset is public, so the site reads it by default and falls back to the
# static articles in `lib/content.ts` if Sanity cannot be reached.

# SERVER ONLY. Two jobs:
#   1. the PRIVATE `submissions` dataset — the demo queue and, separately, the
#      manager contact details for each submission. It is private precisely so
#      no anonymous reader can reach them;
#   2. reading UNPUBLISHED drafts for the preview route (`/preview/<type>/<slug>`).
# If this ever reaches the browser, so does every contact number in the queue.
SANITY_API_READ_TOKEN=

# Shared with the Sanity webhook that points at POST /api/revalidate, so pressing
# Publish clears the article cache immediately. Without it, the route refuses
# every request — an open revalidation endpoint is a cache-busting DoS waiting
# to happen.
SANITY_REVALIDATE_SECRET=

# Optional. The secret a preview link must carry. It is deliberately its own
# secret: reading a draft and clearing a cache are different jobs, and the
# fallback to SANITY_REVALIDATE_SECRET was removed on 22 Oct 2026. Without this
# value the preview route answers 404 for every link.
SANITY_PREVIEW_SECRET=

# Temporary. The value SANITY_REVALIDATE_SECRET had before it was rotated.
# The webhook still sends the old secret until its dashboard is pointed at the
# new one; delete this variable afterwards.
SANITY_REVALIDATE_SECRET_PREVIOUS=

# --- Demo submission ------------------------------------------------------
# Optional. Vercel Blob token for the demo audio upload. Without it the upload
# token endpoint answers 400 and the form falls back to "send without audio".
# Create a Blob store in the Vercel dashboard first.
BLOB_READ_WRITE_TOKEN=

# Optional. Store ID for the exact-host audio check. Vercel injects it when the
# store is connected; without it the check falls back to the shared Blob suffix.
BLOB_STORE_ID=

# Optional. Set to 1 only when a trusted reverse proxy sets X-Forwarded-For
# (self-hosting). On Vercel the platform sets it automatically; without this,
# every caller shares one rate-limit bucket.
TRUST_PROXY=

# --- Rate limit -----------------------------------------------------------
# Optional. Shared counter for /api/demos and /api/demo-audio. Vercel KV and
# Upstash expose the same REST shape; set one pair. Without it the limiter
# falls back to per-instance memory, which does not stop a burst spread over
# several serverless instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Resend API key for the "a new demo arrived" notification to the
# team. Without it the submission is still stored — only the email is skipped.
RESEND_API_KEY=

# Optional. Who the demo notification goes to, and who it appears to come
# from. Both have defaults in app/api/demos/route.ts:
#   DEMO_NOTIFY_TO     melodialam.ip@gmail.com,helfan@infia.co
#   DEMO_NOTIFY_FROM   Melodi Alam <onboarding@resend.dev>
DEMO_NOTIFY_TO=
DEMO_NOTIFY_FROM=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Local helpers (not needed in production) ----------------------------
# scripts/gdrive-auth.mjs and scripts/gdrive-fetch.mjs pull editorial photos
# from Google Drive. They read the OAuth client JSON from the .secrets folder
# beside the two repos (../.secrets/gdrive-client.json) unless
# GDRIVE_CLIENT_JSON points somewhere else, and use port 8420 for the OAuth
# callback unless GDRIVE_AUTH_PORT says otherwise.
GDRIVE_CLIENT_JSON=
GDRIVE_AUTH_PORT=8420
