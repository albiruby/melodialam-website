# --- Sanity ---------------------------------------------------------------
# The site runs without any of this: `lib/articles.ts` falls back to the twelve
# articles in lib/content.ts and the demo queue falls back to process memory.
# Fill these in to turn the CMS on.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The demo queue lives in its own PRIVATE dataset so musician contact details
# are never publicly readable. Verified: an unauthenticated query returns null
# for documents the same query returns with the token.
NEXT_PUBLIC_SANITY_SUBMISSIONS_DATASET=submissions

NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3100/studio

# SERVER ONLY. Grants read on the private submissions dataset and write access
# to the demo queue. If this reaches the browser, so does every contact detail.
SANITY_API_READ_TOKEN=

# Shared with the Sanity webhook that points at POST /api/revalidate, so
# pressing Publish clears the article cache immediately.
SANITY_REVALIDATE_SECRET=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
