# --- Sanity ---------------------------------------------------------------
# The project id and both dataset names are NOT here. They are literals in
# `lib/sanity-project.ts`, because `sanity.config.ts` is built twice — by Next
# for the embedded Studio and by Sanity's own bundler for the hosted one — and
# the two expose environment variables differently. A literal is the only form
# both bundlers agree on. See that module for the full explanation.
#
# Reading articles therefore needs no configuration at all: the `production`
# dataset is public, so the site reads it by default and falls back to the
# static articles in `lib/content.ts` if Sanity cannot be reached.

# SERVER ONLY, and needed only for the demo queue. Grants read on the PRIVATE
# `submissions` dataset and write access to it. If this ever reaches the
# browser, so does every musician's contact number.
SANITY_API_READ_TOKEN=

# Shared with the Sanity webhook that points at POST /api/revalidate, so pressing
# Publish clears the article cache immediately. Without it, the route refuses
# every request — an open revalidation endpoint is a cache-busting DoS waiting
# to happen.
SANITY_REVALIDATE_SECRET=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
