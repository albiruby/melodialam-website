# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.
# Everything here is optional: without DATABASE_URL the public site keeps
# serving from lib/content.ts, and only /admin and the database-backed demo
# queue refuse to work.

# --- Payload ---
# 32+ random characters. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Required while next.config.ts has `cacheComponents: true`. Payload switches its
# root layout to a Suspense wrapper under this flag; without it the admin panel
# throws a hydration mismatch on its injected <style> (server renders the CSS
# object as JSON, client renders the raw CSS text) and the panel never settles.
# See node_modules/@payloadcms/next/dist/layouts/Root/index.js.
PAYLOAD_CACHE_COMPONENTS_ENABLED=true

# --- Postgres (Supabase: Project Settings -> Database -> Connection string) ---
# Use the pooled (Supavisor, port 6543) string for the app, e.g.:
# postgresql://postgres.<ref>:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Supabase Storage via the S3-compatible API (all five or none) ---
# Dashboard -> Storage -> S3 access keys. Bucket e.g. "melodi-alam-media".
# Endpoint shape: https://<project-ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Public site origin (already has a code default, override per deploy) ---
NEXT_PUBLIC_SITE_URL=https://melodialam.id
