{
  "name": "melodi-alam",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "test": "vitest run",
    "catalogue": "node scripts/build-catalogue.mjs",
    "brand": "node scripts/build-brand.mjs",
    "photos": "node scripts/copy-photos.mjs",
    "seed:sanity": "node node_modules/typescript/bin/tsc lib/content-fallback.ts lib/taxonomy.ts lib/site.ts --outDir .seed-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck --esModuleInterop && node scripts/seed-sanity.cjs .seed-build",
    "seed:videos": "node scripts/seed-videos.cjs",
    "backup": "node scripts/export-sanity.mjs",
    "purge-demos": "node scripts/purge-demos.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
